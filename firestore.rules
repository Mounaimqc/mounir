rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 📦 Collection 'commandes'
    match /commandes/{docId} {
      allow read, write: if true;
    }
    
    // 🏷️ Collection 'produits'
    match /produits/{docId} {
      allow read, write: if true;
    }

    // 📱 Collection 'fcm_tokens'
    match /fcm_tokens/{tokenId} {
      // Autoriser uniquement la création et la mise à jour des tokens FCM par les clients
      allow create, update: if request.resource.data.token is string;
      
      // Interdire strictement la lecture et la suppression depuis le navigateur web
      // (Seule la Cloud Function lira les tokens via Firebase Admin SDK)
      allow read, delete: if false;
    }
  }
}
