rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 📦 Collection 'commandes'
    match /commandes/{docId} {
      allow read, write: if true;
    }
    
    // 🏷️ Collection 'produits'
    match /produits/{docId} {
      allow read, write: if true;
    }

    // 📱 Collection 'fcm_tokens'
    match /fcm_tokens/{tokenId} {
      // Autoriser l'écriture (création/mise à jour) des tokens FCM
      allow write: if true;
      // Interdire la lecture des tokens depuis le navigateur web pour protéger la confidentialité
      allow read: if false;
    }
  }
}
