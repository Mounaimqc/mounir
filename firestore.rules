rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 📦 Collection 'commandes'
    match /commandes/{docId} {
      // Autoriser les clients à créer des commandes validées
      allow create: if request.resource.data.orderNumber is string
                    && request.resource.data.orderNumber.size() > 0;
      
      // En l'absence de Firebase Auth, le Dashboard Admin lit et gère les commandes sans Auth
      allow read, update, delete: if true;
    }
    
    // 🏷️ Collection 'produits'
    match /produits/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 📱 Collection 'fcm_tokens'
    match /fcm_tokens/{tokenId} {
      // Seul l'enregistrement d'un token valide correspondant à son propre ID est autorisé
      allow create, update: if tokenId == request.resource.data.token
                            && request.resource.data.token is string
                            && request.resource.data.token.size() > 20;
      
      // Sécurité maximale: AUCUN client web ne peut lire ou lister les tokens des autres appareils
      // La Cloud Function utilise Firebase Admin SDK qui outrepasse ces règles en toute sécurité
      allow read, delete: if false;
    }
  }
}
