rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 📦 Collection 'commandes'
    match /commandes/{docId} {
      allow create: if request.resource.data.orderNumber is string;
      allow read, update, delete: if true;
    }
    
    // 🏷️ Collection 'produits'
    match /produits/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 📱 Collection 'fcm_tokens'
    match /fcm_tokens/{tokenId} {
      // Permettre l'enregistrement du token FCM par le frontend
      allow create, update: if request.resource.data.token is string;
      // Empêcher la lecture ou suppression par les clients web (Seule la Cloud Function lit les tokens)
      allow read, delete: if false;
    }
  }
}
