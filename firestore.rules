rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 📦 Collection 'commandes'
    match /commandes/{docId} {
      // Permettre aux clients de créer des commandes
      allow create: if request.resource.data.orderNumber != null;
      // Permettre la lecture et la mise à jour par le panel Admin
      allow read, update, delete: if true;
    }
    
    // 🏷️ Collection 'produits'
    match /produits/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 📱 Collection 'fcm_tokens'
    match /fcm_tokens/{tokenId} {
      // Permettre l'enregistrement et la mise à jour des tokens FCM d'administration
      allow create, update: if request.resource.data.token != null;
      // Permettre la lecture/suppression
      allow read, delete: if true;
    }
  }
}
